# --- Go ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
profile.cov
coverage.*
go.work
go.work.sum

# Bare `go build ./` lands the binary at the repo root
/gowit

# --- Node / frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
*.tsbuildinfo

# Keep the embed placeholder: main.go //go:embed all:frontend/dist needs the
# directory to exist on a fresh clone, but not the vite build output.
frontend/dist/*
!frontend/dist/.gitkeep

# Wails regenerates this hash of package.json next to it
frontend/package.json.md5

# Generated TS bindings: TRACKED on purpose. tsc, eslint and vitest must run
# (incl. in CI) without the Wails toolchain; `wails build/dev` regenerates
# them and any drift shows up in the diff for review.

# --- Wails build output ---
build/bin/

# --- Test output ---
coverage/
frontend/coverage/
test-results/
playwright-report/

# --- Env / local overrides ---
.env
.env.*
*.local

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local agent skills library (see AGENTS.md) ---
skills/

# --- Logs ---
*.log
