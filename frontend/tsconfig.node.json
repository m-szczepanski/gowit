{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/tsconfig.node.declarations",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "vite.config.ts"
  ]
}
