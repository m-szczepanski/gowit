    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
